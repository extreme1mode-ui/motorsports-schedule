{
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [{ "type": "host", "value": "motorsports-schedule.vercel.app" }],
      "destination": "https://www.gantryracing.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300, stale-while-revalidate=86400" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/race/:id", "destination": "/index.html" },
    { "source": "/race/:id/", "destination": "/index.html" }
  ]
}
