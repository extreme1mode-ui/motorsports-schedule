# PostHog 프로젝트 API 키 (EU 리전, phc_…). 비워두면 프로덕션에서도 전송하지 않는다 (src/analytics.js).
# 로컬은 .env.local(gitignore)에, Vercel은 Environment Variables에 넣는다.
VITE_ANALYTICS_KEY=

# Supabase (서울 리전). 브라우저에 노출돼도 되는 값만 쓴다 — 비밀 키(sb_secret_…)는 넣지 않는다.
# 둘 중 하나라도 비면 원격 계층 전체가 아무것도 하지 않는다 (src/account/).
# Vercel Function(api/calendar.ics.js)도 같은 두 값을 읽는다.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile 사이트 키 (Invisible 모드). 익명 로그인 직전에만 쓴다.
# 비워두면 CAPTCHA 없이 익명 로그인을 시도한다.
VITE_TURNSTILE_SITE_KEY=
